{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "Test Studio configuration",
	"type": "object",
	"additionalProperties": false,
	"properties": {
		"$schema": {
			"type": "string"
		},
		"name": {
			"type": "string",
			"minLength": 1
		},
		"port": {
			"type": "integer",
			"minimum": 0,
			"maximum": 65535,
			"default": 4310
		},
		"adapters": {
			"type": "array",
			"default": ["bun", "maestro"],
			"items": {
				"oneOf": [
					{
						"type": "string",
						"minLength": 1
					},
					{
						"type": "object",
						"additionalProperties": false,
						"required": ["use"],
						"properties": {
							"use": {
								"type": "string",
								"minLength": 1
							},
							"options": {
								"type": "object"
							},
							"docker": {
								"$ref": "#/$defs/docker"
							}
						}
					},
					{
						"type": "object",
						"additionalProperties": false,
						"required": ["id", "files", "executable", "args"],
						"properties": {
							"id": {
								"type": "string",
								"minLength": 1
							},
							"label": {
								"type": "string",
								"minLength": 1
							},
							"executable": {
								"type": "string",
								"minLength": 1
							},
							"cwd": {
								"type": "string",
								"minLength": 1
							},
							"files": {
								"type": "array",
								"minItems": 1,
								"items": {
									"type": "string",
									"minLength": 1
								}
							},
							"args": {
								"type": "array",
								"items": {
									"type": "string"
								}
							},
							"docker": {
								"$ref": "#/$defs/docker"
							}
						}
					}
				]
			}
		},
		"exclude": {
			"type": "array",
			"items": {
				"type": "string"
			},
			"default": []
		},
		"ignoreFile": {
			"oneOf": [
				{
					"type": "string",
					"minLength": 1
				},
				{
					"const": false
				}
			],
			"default": ".teststudioignore"
		},
		"respectGitignore": {
			"type": "boolean",
			"default": true
		},
		"timeoutMs": {
			"type": "integer",
			"minimum": 1,
			"maximum": 2147483647,
			"default": 1800000
		}
	},
	"$defs": {
		"docker": {
			"type": "object",
			"additionalProperties": false,
			"required": ["service", "projectRoot"],
			"properties": {
				"service": {
					"type": "string",
					"minLength": 1
				},
				"projectRoot": {
					"type": "string",
					"minLength": 1
				},
				"file": {
					"type": "string",
					"minLength": 1
				}
			}
		}
	}
}
