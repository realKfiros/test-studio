{
	"name": "test-studio",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"start": "node dist/cli.js",
		"test": "bun test ./tests",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "eslint . --max-warnings 0",
		"lint:fix": "eslint . --fix --max-warnings 0",
		"dev": "bun cli.ts",
		"build": "node scripts/build.mjs",
		"prepack": "npm run build",
		"test:package": "npm run build && node scripts/smoke-package.mjs"
	},
	"dependencies": {
		"fast-xml-parser": "^5.7.3",
		"ignore": "^7.0.9",
		"jiti": "^2.7.0",
		"typescript": "^6.0.2",
		"which": "^5.0.0",
		"yaml": "^2.8.3"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/node": "^22.0.0",
		"@types/which": "^3.0.4",
		"bun-types": "^1.3.14",
		"eslint": "^10.2.0",
		"globals": "^17.5.0",
		"prettier": "^3.9.8",
		"typescript-eslint": "^8.58.1"
	},
	"description": "A local test explorer and runner with pluggable framework adapters.",
	"engines": {
		"node": ">=22"
	},
	"bin": {
		"test-studio": "./dist/cli.js"
	},
	"files": [
		"dist/",
		"schema.json",
		"docs/",
		"examples/"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./schema.json": "./schema.json",
		"./adapters/bun": {
			"types": "./dist/adapters/bun.d.ts",
			"import": "./dist/adapters/bun.js"
		},
		"./adapters/maestro": {
			"types": "./dist/adapters/maestro.d.ts",
			"import": "./dist/adapters/maestro.js"
		}
	}
}
