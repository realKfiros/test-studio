{
	"name": "test-studio",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"start": "bun server.ts",
		"test": "bun test ./tests",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "eslint . --max-warnings 0",
		"lint:fix": "eslint . --fix --max-warnings 0"
	},
	"dependencies": {
		"fast-xml-parser": "^5.7.3",
		"typescript": "^6.0.2",
		"yaml": "^2.8.3"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"bun-types": "^1.3.14",
		"eslint": "^10.2.0",
		"globals": "^17.5.0",
		"prettier": "^3.9.8",
		"typescript-eslint": "^8.58.1"
	},
	"description": "A local test explorer and runner for Bun tests and Maestro flows.",
	"engines": {
		"bun": ">=1.3.0"
	}
}
